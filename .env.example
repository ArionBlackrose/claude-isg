# Veritabanı dosyası (göreli veya mutlak yol)
DATABASE_URL=./data/app.db

# better-auth için rastgele, uzun bir gizli anahtar (ör. `openssl rand -hex 32`)
BETTER_AUTH_SECRET=

# Uygulamanın canlıda erişileceği tam URL (ör. https://egitim.sirketiniz.com)
BETTER_AUTH_URL=http://localhost:3000

# İlk kurulumda (npm run db:seed) oluşturulacak yönetici hesabı
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=

# E-posta gönderimi (giriş kodları + haftalık eğitim durumu bildirimi).
# Tanımlanmazsa e-postalar gönderilmez, kodlar sunucu logunda gösterilir
# (sadece geliştirme için uygundur). CANLIYA ALMADAN ÖNCE İKİSİ DE
# ZORUNLUDUR — aksi halde kimse giriş kodu alamaz.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Geliştirme ortamında e-posta ile giriş akışını atlayıp otomatik olarak
# ilk admin kullanıcı olarak oturum açmak için "true" yapın (src/lib/
# session.ts, LOGIN_DISABLED_TEMPORARILY). Boş bırakılırsa (veya "true"
# dışında bir değer) gerçek e-posta OTP girişi kullanılır. Bu bayrak
# NODE_ENV=production'da her koşulda devre dışıdır ve production'a asla
# ALLOW_DEV_LOGIN_BYPASS=true ile deploy edilmemelidir.
ALLOW_DEV_LOGIN_BYPASS=

# NOT: canlıya geçmeden önce yapılması gereken tek şey yukarıdaki
# RESEND_API_KEY / RESEND_FROM_EMAIL değerlerini gerçek bir Resend
# hesabıyla doldurmak ve ALLOW_DEV_LOGIN_BYPASS'ı boş/tanımsız bırakmaktır.
