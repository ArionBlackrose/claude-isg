# Veritabanı dosyası (göreli veya mutlak yol)
DATABASE_URL=./data/app.db

# better-auth için rastgele, uzun bir gizli anahtar (ör. `openssl rand -hex 32`)
BETTER_AUTH_SECRET=

# Uygulamanın canlıda erişileceği tam URL (ör. https://egitim.sirketiniz.com)
BETTER_AUTH_URL=http://localhost:3000

# İlk kurulumda (npm run db:seed) oluşturulacak yönetici hesabı
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=

# E-posta gönderimi (giriş kodları + haftalık eğitim durumu bildirimi).
# Tanımlanmazsa e-postalar gönderilmez, kodlar sunucu logunda gösterilir
# (sadece geliştirme için uygundur). CANLIYA ALMADAN ÖNCE İKİSİ DE
# ZORUNLUDUR — aksi halde kimse giriş kodu alamaz.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# NOT: Geliştirme ortamında (NODE_ENV != production) e-posta girişi
# otomatik olarak atlanıp ilk admin kullanıcı olarak oturum açılır
# (src/lib/session.ts, LOGIN_DISABLED_TEMPORARILY). Bu bayrak
# production'da (NODE_ENV=production) her koşulda devre dışıdır —
# canlıya geçmeden önce yapılması gereken tek şey yukarıdaki
# RESEND_API_KEY / RESEND_FROM_EMAIL değerlerini gerçek bir Resend
# hesabıyla doldurmaktır.
